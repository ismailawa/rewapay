# ==============================================================================
# RewaPay × Cray Module Environment Configuration (.env.example)
# Official Docs: https://docs.crayfi.com/v2
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Cray Finance API Configuration
# ------------------------------------------------------------------------------

# Environment: 'staging' | 'production' | 'test'
CRAY_ENVIRONMENT=staging

# Official Cray v2 Base URLs:
#   Staging:    https://sandbox.crayfi.io
#   Production: https://pay.crayfi.io
CRAY_BASE_URL=https://sandbox.crayfi.io

# ==============================================================================
# CRAY CREDENTIALS
#
# Cray provides THREE separate key types (all from Dashboard → Settings → Developer):
#
#   1. CRAYFI_MERCHANT_KEY_TEST  — Scoped API key (collection | disbursement | conversion)
#      Used as:  Authorization: Bearer <key>  on every main API request.
#      Covers:   Virtual accounts, payouts, disburse, balance, hosted checkout.
#
#   2. CRAYFI_PUBLIC_KEY_TEST    — Public key (lrp_...) for Payment Initialization
#      Used as:  `public_key` field in the request BODY (no Authorization header).
#      Covers:   /payments/initialize, /payment/create, /payment/merchant/create
#
#   3. CRAYFI_SECRET_KEY_TEST    — Secret key (lrs_...) for payment verification
#      Used as:  URL path param in GET /payment/merchant/verify/{ref}/{secretKey}
#      ⚠️  Never expose in browser code, logs, or client-side requests.
#
# In production, replace TEST keys with live keys (no _TEST suffix).
# ==============================================================================

# 1. Scoped merchant API key — Bearer token for main API
CRAYFI_MERCHANT_KEY_TEST=your_merchant_api_key_here

# 2. Public key — sent in request body for payment-init endpoints
CRAYFI_PUBLIC_KEY_TEST=lrp_your_public_key_here

# 3. Secret key — sent in URL path for payment-verify endpoint only
CRAYFI_SECRET_KEY_TEST=lrs_your_secret_key_here

# ------------------------------------------------------------------------------
# Request Signing (ES256 ECDSA P-256 / SHA-256 DER Base64)
# Required on all endpoints when signing mode is set to "Required" in Dashboard.
# Docs: https://docs.crayfi.com/v2/cray-docs/request-signing
#
# To generate a key pair:
#   openssl ecparam -name prime256v1 -genkey -noout -out cray-signing-key.pem
#   openssl ec -in cray-signing-key.pem -pubout -out cray-signing-key.pub.pem
# Then register cray-signing-key.pub.pem in Dashboard → Settings → Developer → Request signing keys.
# ------------------------------------------------------------------------------

# Set to true only if request signing is enabled in your Cray Dashboard
CRAY_REQUEST_SIGNING_ENABLED=true

# Key ID (kid UUID) shown for your registered signing key in the Dashboard
CRAY_SIGNING_KEY_ID=your_registered_key_id

# Private Key (ECDSA P-256 PEM format — keep this secret, never commit)
# Note: For multi-line PEM, wrap in quotes with literal \n or paste raw PEM
CRAY_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# Webhooks Configuration
# Docs: https://docs.crayfi.com/v2/cray-docs/webhooks
# ------------------------------------------------------------------------------

# Webhook Secret: Dedicated API key generated with the 'webhook' scope only.
# Used for HMAC-SHA256 signature verification over the 'data' payload.
# ⚠️  A webhook-scoped key CANNOT call the main API — it is for verification only.
CRAY_WEBHOOK_SECRET=your_webhook_scoped_api_key

# Comma-separated list of allowed sender IPs for payin/payout webhooks
# Leave empty in development to allow localhost/test requests
CRAY_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1

# ------------------------------------------------------------------------------
# HTTP Transport, Retries & Rate Limiting
# Rate Limits: 60 RPM for general, 30 RPM for collections & disbursements
# ------------------------------------------------------------------------------
CRAY_HTTP_TIMEOUT_MS=15000
CRAY_MAX_RETRIES=3
CRAY_GENERAL_RPM=60
CRAY_COLLECTION_PAYOUT_RPM=30

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------

# Refunds: Deferred to Phase 2 (post-MVP) pending Cray complete refund contracts
CRAY_ENABLE_REFUNDS=false

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (TypeORM)
# Required for persisting transfers, virtual accounts, idempotency, and audit records
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=rewapay_cray
DATABASE_SSL=false

