# ==============================================================================
# RewaPay × Cray v1 environment configuration
# Documentation: https://docs.crayfi.com/v1
# Copy this file to .env and replace the required placeholders. Never commit
# real credentials or encryption material.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

# Cray v1 uses one merchant API key as the Bearer credential for every provider
# call implemented by this module and for signed `collection.*` webhook HMACs.
# Set this to the staging merchant API key from the Cray dashboard. It is not the
# separate public key or payment-verification secret. Never expose it to clients.
CRAY_API_KEY=replace_with_staging_merchant_api_key

# Application-owned secret used for AES-256-GCM encryption of account numbers.
# Generate this independently of the Cray credential, for example:
#   openssl rand -base64 32
# Keep the same value available for reads and security backfill migrations.
CRAY_DATA_ENCRYPTION_KEY=replace_with_generated_encryption_secret

# Required by the host TypeORM DataSource.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rewapay_cray

# ------------------------------------------------------------------------------
# Application and Cray environment (optional; defaults shown)
# ------------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Supported values: staging | production | test. Defaults to staging.
CRAY_ENVIRONMENT=staging

# Cray directed this staging integration to use the production gateway. Keep
# CRAY_ENVIRONMENT=staging so the remaining configuration stays in staging.
CRAY_BASE_URL=https://pay.connectramp.com

# ------------------------------------------------------------------------------
# Optional ES256 request signing
# ------------------------------------------------------------------------------

# Bearer authentication remains mandatory. Enable this only when the merchant's
# Cray request-signing mode is Optional or Required and signatures are desired.
CRAY_REQUEST_SIGNING_ENABLED=false

# Generate a P-256 key pair and register the public key in the Cray dashboard:
#   openssl ecparam -name prime256v1 -genkey -noout -out cray-signing-key.pem
#   openssl ec -in cray-signing-key.pem -pubout -out cray-signing-key.pub.pem
# Store the private key in a secrets manager. Use literal \n characters when a
# deployment platform requires a single-line environment value.
# Conditionally required when CRAY_REQUEST_SIGNING_ENABLED=true.
CRAY_SIGNING_KEY_ID=
CRAY_SIGNING_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Webhook verification
# ------------------------------------------------------------------------------

# `collection.*` webhooks are verified with CRAY_API_KEY. Legacy `payin` and
# `payout` events are unsigned and confirmed through authoritative API requery.

# ------------------------------------------------------------------------------
# HTTP transport, retries, and rate limiting
# ------------------------------------------------------------------------------

CRAY_HTTP_TIMEOUT_MS=15000
CRAY_MAX_RETRIES=3
CRAY_GENERAL_RPM=60
CRAY_COLLECTION_PAYOUT_RPM=30

# ------------------------------------------------------------------------------
# Opt-in live contract tests
# ------------------------------------------------------------------------------

# `npm run test:e2e:live` sets RUN_CRAY_LIVE_E2E=true automatically and makes
# read-only calls exclusively to the Cray v1 production gateway, as directed by
# Cray. The script overrides the environment and URL; custom/staging URLs are
# rejected by the suite itself.
RUN_CRAY_LIVE_E2E=false

# Defaults to CRAY_HTTP_TIMEOUT_MS + 5000 so Jest does not abort before the
# provider request reaches its own timeout.
CRAY_LIVE_E2E_TIMEOUT_MS=20000

# Mutations require a second, explicit opt-in. The dedicated command uses the
# staging configuration on the production URL, creates a permanent Bloc virtual
# account, and generates a fresh reference:
# `npm run test:e2e:live:virtual-account`.
RUN_CRAY_LIVE_MUTATION_E2E=false

# ------------------------------------------------------------------------------
# PostgreSQL / TypeORM
# ------------------------------------------------------------------------------

# Optional compose.yaml overrides. Keep DATABASE_URL in sync if these change.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rewapay_cray
POSTGRES_PORT=5433

DATABASE_SSL=false
