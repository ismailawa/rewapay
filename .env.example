# ==============================================================================
# RewaPay × Cray v2 environment configuration
# Documentation: https://docs.crayfi.com/v2
# Copy this file to .env and replace every placeholder. Never commit real keys.
# ==============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Cray environment
# ------------------------------------------------------------------------------

# Supported values: staging | production | test
CRAY_ENVIRONMENT=staging

# Staging: https://sandbox.crayfi.io
# Live:    https://pay.crayfi.io
CRAY_BASE_URL=https://sandbox.crayfi.io

# ------------------------------------------------------------------------------
# Scoped API keys
# ------------------------------------------------------------------------------

# Cray keys carry exactly one scope. These must be two distinct keys created for
# the matching environment under Dashboard → Settings → Developer → API Keys.
CRAY_COLLECTION_API_KEY=lrs_replace_with_collection_scoped_secret_key
CRAY_DISBURSEMENT_API_KEY=lrs_replace_with_disbursement_scoped_secret_key

# ------------------------------------------------------------------------------
# Optional ES256 request signing
# ------------------------------------------------------------------------------

# Bearer authentication remains mandatory. Enable this only when the merchant's
# Cray request-signing mode is Optional or Required and signatures are desired.
CRAY_REQUEST_SIGNING_ENABLED=false

# Generate a P-256 key pair and register the public key in the Cray dashboard:
#   openssl ecparam -name prime256v1 -genkey -noout -out cray-signing-key.pem
#   openssl ec -in cray-signing-key.pem -pubout -out cray-signing-key.pub.pem
# Store the private key in a secrets manager. Use literal \n characters when a
# deployment platform requires a single-line environment value.
# These are required only when CRAY_REQUEST_SIGNING_ENABLED=true.
CRAY_SIGNING_KEY_ID=
CRAY_SIGNING_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Webhook verification and encrypted persistence
# ------------------------------------------------------------------------------

# Comma-separated webhook-scope keys. Keep the previous key during rotation;
# Cray-Webhook-Key selects the matching key by its final four characters.
CRAY_WEBHOOK_KEYS=replace_with_current_webhook_key,replace_with_previous_webhook_key

# Application-owned secret used for AES-256-GCM encryption of account numbers.
# Generate and store this independently of Cray credentials. It must remain
# available for reads and for the security backfill migration.
CRAY_DATA_ENCRYPTION_KEY=replace_with_secret_from_key_manager

# ------------------------------------------------------------------------------
# HTTP transport, retries, and rate limiting
# ------------------------------------------------------------------------------

CRAY_HTTP_TIMEOUT_MS=15000
CRAY_MAX_RETRIES=3
CRAY_GENERAL_RPM=60
CRAY_COLLECTION_PAYOUT_RPM=30

# ------------------------------------------------------------------------------
# PostgreSQL / TypeORM
# ------------------------------------------------------------------------------

# Used by compose.yaml. Keep DATABASE_URL in sync if these values change.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rewapay_cray
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rewapay_cray
DATABASE_SSL=false
